{
  "name": "ui-iceberg",
  "version": "0.1.0",
  "description": "Open-source UI journey assurance and test-scenario intelligence.",
  "type": "module",
  "private": false,
  "license": "Apache-2.0",
  "bin": {
    "ui-iceberg": "packages/cli/bin/ui-iceberg.js"
  },
  "exports": {
    ".": "./packages/core/src/index.js",
    "./scenarios": "./packages/scenarios/src/catalog.js",
    "./mcp": "./mcp/server/index.js"
  },
  "scripts": {
    "test": "node --test",
    "check": "node --check packages/cli/bin/ui-iceberg.js && node --check packages/core/src/index.js && node --check packages/scenarios/src/catalog.js && node --check mcp/server/index.js",
    "mcp": "node mcp/server/index.js",
    "demo": "node packages/cli/bin/ui-iceberg.js scenarios checkout"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "ui-testing",
    "journey-testing",
    "test-scenarios",
    "playwright",
    "selenium",
    "cypress",
    "mcp",
    "ai-coding-agent"
  ]
}
